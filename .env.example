# ─────────────────────────────────────────────────────────────────────────────
# 2FA Authenticator — environment variables
# Copy to .env.local for development, or set these in Vercel →
# Project → Settings → Environment Variables for production.
# Full walkthrough: see SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Neon Postgres connection string.
# Use the POOLED connection string from the Neon dashboard:
#   Project → Connect → connection string with "Pooled connection" checked.
# It looks like:
#   postgresql://user:password@ep-cool-name-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# REQUIRED — 32-byte base64 key used to AES-256-GCM encrypt 2FA secrets at rest.
# Generate one:  openssl rand -base64 32
# (or let the Colab notebook generate it for you)
ENCRYPTION_KEY=

# REQUIRED — session token signing secret (HS256). Minimum 32 characters.
# Generate one:  openssl rand -base64 32
SESSION_SECRET=

# OPTIONAL — canonical public URL (used for SEO metadata, sitemap, OG tags).
# Defaults to https://2fa.namansoni.in when unset.
NEXT_PUBLIC_SITE_URL=https://2fa.namansoni.in

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY
# Set this instead of a Neon URL to run the app with an in-memory database
# persisted to db/mock-db.json — perfect for trying the project with zero setup.
# Never use this in production.
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=mock://local-dev
